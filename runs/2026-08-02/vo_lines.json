{
  "lines": [
    {
      "idx": 0,
      "who": "RAY",
      "start": 0.0,
      "end": 5.049,
      "text": "Ford recalled its hybrid SUVs over a noise they're required to make.",
      "voice": "Algenib",
      "claims": [
        "c1",
        "c2",
        "c8"
      ]
    },
    {
      "idx": 1,
      "who": "DEE",
      "start": 5.31,
      "end": 9.282,
      "text": "It doesn't always play. That's the recall.",
      "voice": "Schedar",
      "claims": [
        "c2"
      ]
    },
    {
      "idx": 2,
      "who": "RAY",
      "start": 9.54,
      "end": 11.285,
      "text": "So fix it.",
      "voice": "Algenib",
      "claims": []
    },
    {
      "idx": 3,
      "who": "DEE",
      "start": 11.55,
      "end": 17.889,
      "text": "They did, in October. Software update, letters mailed November fifth.",
      "voice": "Schedar",
      "claims": [
        "c9"
      ]
    },
    {
      "idx": 4,
      "who": "DEE",
      "start": 18.14,
      "end": 21.46,
      "text": "Forty-three thousand, four hundred thirty-eight.",
      "voice": "Schedar",
      "claims": [
        "c10"
      ]
    },
    {
      "idx": 5,
      "who": "DEE",
      "start": 21.72,
      "end": 26.475,
      "text": "It's back. Sixty-six thousand, three hundred eighty-three.",
      "voice": "Schedar",
      "claims": [
        "c1",
        "c10"
      ]
    },
    {
      "idx": 6,
      "who": "DEE",
      "start": 26.74,
      "end": 32.251,
      "text": "NHTSA calls it an expansion. The ones they fixed have to be fixed again.",
      "voice": "Schedar",
      "claims": [
        "c5"
      ]
    },
    {
      "idx": 7,
      "who": "DEE",
      "start": 32.51,
      "end": 37.247,
      "text": "The only fix they have is for the version with twenty-eight speakers.",
      "voice": "Schedar",
      "claims": [
        "c3",
        "c4"
      ]
    },
    {
      "idx": 8,
      "who": "RAY",
      "start": 37.51,
      "end": 42.34,
      "text": "Twenty-eight speakers. That's how they decide who gets fixed.",
      "voice": "Algenib",
      "claims": [
        "c3"
      ]
    },
    {
      "idx": 9,
      "who": "INSTITUTION",
      "start": 42.6,
      "end": 48.622,
      "text": "Interim letters notifying owners of the safety risk are expected to be mailed August third.",
      "voice": "Despina",
      "claims": [
        "c7"
      ]
    },
    {
      "idx": 10,
      "who": "RAY",
      "start": 48.88,
      "end": 50.23,
      "text": "That's tomorrow.",
      "voice": "Algenib",
      "claims": [
        "c7"
      ]
    },
    {
      "idx": 11,
      "who": "RAY",
      "start": 50.49,
      "end": 53.128,
      "text": "I still have the first letter.",
      "voice": "Algenib",
      "claims": [
        "c9"
      ]
    }
  ]
}